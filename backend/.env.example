# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/gamja_market
MIGRATION_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/gamja_market
AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
# Local development stores photos under backend/.local-storage (ignored by Git).
PHOTO_STORAGE_DRIVER=local
PHOTO_LOCAL_STORAGE_DIR=.local-storage
# Production uses a PRIVATE Supabase Storage bucket (Public OFF). Keep the secret server-only.
# Allow image/jpeg, image/png, image/webp; set bucket file limit to 3145728 bytes.
# Do not add anonymous storage.objects SELECT policies. See docs/specs/08-private-request-photo-bucket.md.
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_SECRET_KEY=server-only-secret
# SUPABASE_STORAGE_BUCKET=request-photos
