# Never commit real credentials.
DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/gamja_market
MIGRATION_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/gamja_market
AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
PHOTO_STORAGE_DRIVER=disabled
